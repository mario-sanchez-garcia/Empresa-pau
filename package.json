{
  "name": "pau-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "smoke": "node scripts/smoke-p0.mjs && node scripts/smoke-stripe-p0.mjs",
    "smoke:stripe:p0": "node scripts/smoke-stripe-p0.mjs",
    "e2e:auth": "node scripts/run-e2e-auth.mjs",
    "e2e:auth-audit": "playwright test --project=auth-public-audit --project=auth-onboarding-audit",
    "e2e:orientation": "node scripts/run-orientation-e2e.mjs",
    "e2e:camino-orientation": "playwright test --project=camino-orientation",
    "e2e:calendar": "playwright test --project=calendar-editor",
    "e2e:camino-chat": "playwright test --project=camino-chat",
    "e2e:pricing": "playwright test --project=pricing-public",
    "e2e:examenes": "playwright test --project=examenes",
    "e2e:simulacros": "playwright test --project=simulacros",
    "test:orientation": "node --experimental-strip-types --test app/orientacion/calculation.test.ts app/orientacion/catalog.test.ts app/orientacion/community.test.ts app/orientacion/official-data.test.ts app/orientacion/opportunities.test.ts app/orientacion/persistence.test.ts app/orientacion/state.test.ts app/orientacion/university-filters.test.ts app/orientacion/exam-guides.test.ts app/orientacion/access-paths/calculation.test.ts app/orientacion/access-paths/storage.test.ts scripts/orientation/catalog.test.mjs scripts/orientation/catalunya-catalog.test.mjs",
    "test:camino": "node --experimental-strip-types --test app/lib/camino/orientationPriority.test.ts app/lib/camino/chatActions.test.ts app/lib/camino/simulacroEligibility.test.ts app/lib/camino/studyDays.test.ts app/lib/camino/subjectRotation.test.ts app/lib/camino/studyCapacity.test.ts app/lib/camino/examDate.test.ts app/lib/camino/startingPoint.test.ts app/lib/camino/planEngine.test.ts app/lib/camino/knowledgeState.test.ts app/lib/camino/diagnosticLimits.test.ts app/lib/camino/diagnosticAdjustment.test.ts app/lib/camino/diagnosticSafety.test.ts app/lib/camino/missionDuration.test.ts app/lib/camino/planWindow.test.ts app/lib/camino/planDateSafety.test.ts app/lib/camino/rotationWeights.test.ts app/lib/camino/planPlacement.test.ts",
    "test:camino-db": "sh scripts/camino-qa/run-db.sh",
    "test:camino-behavior": "node --test scripts/camino-qa/behavior.test.cjs",
    "test:camino-chat": "npm run test:camino && node scripts/smoke-camino-chat.mjs",
    "test:calendar": "node --conditions=react-server --experimental-strip-types --test app/lib/calendar/google.test.ts app/lib/calendar/oauthState.test.ts && node scripts/smoke-calendar-editor-persistence.mjs",
    "test:auth": "node --experimental-strip-types --test app/lib/auth/emailVerification.test.ts app/lib/auth/emailVerificationFlow.test.ts app/lib/onboarding/postAuthDestination.test.ts",
    "test:pricing": "node --experimental-strip-types --test app/lib/pricing.test.ts",
    "test:billing": "node --experimental-strip-types --test app/lib/billing/stripeEvents.test.ts",
    "test:examenes": "node --experimental-strip-types --test app/lib/camino/examXpGrant.test.ts app/lib/examSelection.test.ts app/hooks/useExamTextDraft.test.ts",
    "test:simulacros": "node --experimental-strip-types --test app/lib/simulacros/lifecycle.test.ts app/lib/simulacros/timeSegments.test.ts && node scripts/smoke-simulacros-security.mjs",
    "test:auth": "node --experimental-strip-types --test app/lib/auth/emailVerification.test.ts app/lib/auth/emailVerificationFlow.test.ts app/lib/auth/safeRedirect.test.ts app/lib/onboarding/postAuthDestination.test.ts app/lib/onboarding/resolveOnboardingDestination.test.ts",
    "test:onboarding": "node --experimental-strip-types --test app/lib/onboarding/saveOnboardingProfile.test.ts app/lib/onboarding/resolveOnboardingDestination.test.ts",
    "test:corrections": "node --experimental-strip-types --test app/lib/ai/withAnthropicRetry.test.ts app/lib/camino/examXpGrant.test.ts app/lib/correctionFetch.test.ts app/lib/correctionRequestValidation.test.ts app/lib/imagePayloadLimits.test.ts app/lib/rateLimitMath.test.ts && node scripts/smoke-correction-parser.cjs && node scripts/smoke-corrections-security.mjs",
    "validate:orientation-data": "node --test scripts/orientation/catalog.test.mjs scripts/orientation/catalunya-catalog.test.mjs",
    "qa:corrections:p0": "node scripts/qa-corrections-p0.mjs",
    "seed:math-curriculum": "node scripts/seed-math-curriculum.mjs",
    "seed:camino-curriculum": "node scripts/seed-camino-curriculum.mjs",
    "seed:curriculum-topics": "node scripts/seed-curriculum-topics.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@supabase/supabase-js": "^2.107.0",
    "@types/three": "^0.184.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "html-to-image": "^1.11.13",
    "katex": "^0.17.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "next": "16.2.7",
    "nextjs-toploader": "^3.9.17",
    "ogl": "^1.0.11",
    "perfect-freehand": "^1.2.3",
    "posthog-js": "^1.417.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.16.0",
    "server-only": "^0.0.1",
    "stripe": "^22.2.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axios": "^1.17.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
