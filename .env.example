# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# IMPORTANT: must be named SUPABASE_SERVICE_ROLE_KEY (not SUPABASE_SERVICE_KEY)
# Required for: Stripe webhook, billing/me, parent checkout, camino reset, admin metrics
# Never prefix with NEXT_PUBLIC_ — server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# Comma-separated emails allowed to use /api/camino/reset and admin endpoints
INTERNAL_USER_EMAILS=you@example.com
# ISO date after which founding price is no longer shown (e.g. 2026-09-01)
FOUNDING_DEADLINE_DATE=2026-09-01
