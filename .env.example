# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# IMPORTANT: must be named SUPABASE_SERVICE_ROLE_KEY (not SUPABASE_SERVICE_KEY)
# Required for: Stripe webhook, billing/me, parent checkout, camino reset, admin metrics
# Never prefix with NEXT_PUBLIC_ — server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar (server-side OAuth)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
GOOGLE_CALENDAR_WEBHOOK_URL=https://your-domain.com/api/calendar/google/webhook
# 32 bytes encoded as base64 or 64 hex chars. Required to encrypt calendar OAuth tokens.
CALENDAR_TOKEN_ENCRYPTION_KEY=base64-32-byte-key
# Any random string >=32 chars. Falls back to CALENDAR_TOKEN_ENCRYPTION_KEY if omitted.
CALENDAR_OAUTH_STATE_SECRET=your-calendar-oauth-state-secret

# PostHog (analítica) — solo se inicializa tras aceptar el banner de cookies (ver
# app/lib/analytics/CookieConsentContext.tsx). EU Cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# Comma-separated emails allowed to use /api/camino/reset and admin endpoints
INTERNAL_USER_EMAILS=you@example.com
# ISO date after which founding price is no longer shown (e.g. 2026-09-01)
FOUNDING_DEADLINE_DATE=2026-09-01
# Secret for signing weekly parent report tokens (any random string ≥32 chars)
INFORME_SECRET=your-secret-here
# Secret for signing email unsubscribe tokens (any random string ≥32 chars)
UNSUBSCRIBE_SECRET=your-secret-here
